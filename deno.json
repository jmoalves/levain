{
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "lint": {
    "include": [
      "src/",
      "*.ts"
    ],
    "exclude": [
      "src/testdata/",
      "data/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ],
      "include": [
        "no-process-globals"
      ]
    }
  },
  "fmt": {
    "files": {
      "include": [
        "src/",
        "*.ts",
        "*.js"
      ],
      "exclude": [
        "src/testdata/",
        "data/"
      ]
    },
    "options": {
      "useTabs": false,
      "lineWidth": 120,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "test": {
    "include": [
      "src/**/*test.ts",
      "test/**/*.ts"
    ],
    "exclude": [
      "data/"
    ]
  },
  "tasks": {
    "dev": "deno run --allow-all --watch levain.ts",
    "test": "deno test --allow-all",
    "compile": "deno compile --allow-all --output=levain levain.ts",
    "compile:windows": "deno compile --allow-all --target x86_64-pc-windows-msvc --output=levain.exe levain.ts",
    "compile:linux": "deno compile --allow-all --target x86_64-unknown-linux-gnu --output=levain levain.ts",
    "compile:mac": "deno compile --allow-all --target x86_64-apple-darwin --output=levain levain.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "cache": "deno cache levain.ts",
    "install-deps": "deno install"
  },
  "imports": {
    "@cliffy/prompt": "jsr:@cliffy/prompt@^1.2.1",
    "@deno-library/progress": "jsr:@deno-library/progress@^1.5.1",
    "@i18next/i18next": "jsr:@i18next/i18next@^26.3.4",
    "@std/": "jsr:@std/",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/async": "jsr:@std/async@^1.5.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@std/log": "jsr:@std/log@^0.224.14",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/testing": "jsr:@std/testing@^1.0.19",
    "@std/yaml": "jsr:@std/yaml@^1.1.2",
    "@webui/deno-webui": "jsr:@webui/deno-webui@^2.5.15",
    "@zip.js/zip.js": "npm:@zip.js/zip.js@^2.8.26",
    "date-fns": "npm:date-fns@^4.4.0",
    "fastest-levenshtein": "npm:fastest-levenshtein@^1.0.16",
    "std/": "jsr:@std/",
    "validator": "npm:validator@^13.15.35"
  },
  "nodeModulesDir": "auto",
  "lock": false
}
